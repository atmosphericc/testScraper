# Session / profile data (user-specific, not committed)
target.json
# Per-account harvested sessions (target-2.json, target-3.json, ...) — live auth tokens
target-*.json
target_storage.json
target_products.json
target_profile/
nodriver-profile/
# Per-account Chrome profiles (nodriver-profile-2/, nodriver-profile-3/, ...)
nodriver-profile-*/
playwright-profile/
chrome_user_data/
# Resilient stack runtime state — contains live Target auth tokens
# (accessToken, idToken, refreshToken). Never commit. The *jar*.json pattern
# also catches probe-script artifacts (e.g. disabled_probe_jar.json).
state/*jar*.json
state/*_profiles/
# Per-retailer proxy state — runtime-only, has live park/burn timestamps
state/proxy_state.json
# 2026-09-17 AC-1 ambiguous-commit latch (runtime state, restored after a relaunch)
state/ambiguous_commit_latch*.json
state/*_proxy_state.json
# Local proxy-pool rollback backups (e.g. config/proxyIps.json.bak_*)
config/proxyIps.json.bak_*
# Per-run log files written by setup_run_logging() — large and may
# capture auth tokens via the tee'd stdout transcript.
logs/runs/

# One-off audit / probe / stress tooling — not required by app.py or
# test_app.py. Lives locally for re-runs; out of git to keep the repo lean.
probe_disabled_browser.py
audit_*.py
probe_*.py
stress_*.py
test_persistent_chromes.py
test_proxies.py

# Output artifacts from the above (CSVs + side-channel logs)
*audit*.csv
stress_*.log
logs/probe_disabled_browser_*.log
logs/resilient_*.log
logs/round2_*.log
logs/smoke_*.log
logs/stage_*.log
logs/purchases/

# Debug screenshots
image.png

# Config with credentials
.env
config/proxyIps.json
# Multi-account credentials (usernames/passwords) — NEVER commit. Template is
# config/target_accounts.example.json (committed); the real file is gitignored.
config/target_accounts.json

# Logs (intentionally tracked for post-mortem of early-morning Target drops)
# logs/
# Sim subprocess run logs (transient, regenerated each test run)

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code — track the agent system so it survives a reimage; keep machine-local
# settings and locks out. NOTE: this repo is PUBLIC, so what is tracked here is
# visible. These files hold method and doctrine only — no credentials, no IPs.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/state/
!.claude/agent-context.md
!.claude/settings.json
