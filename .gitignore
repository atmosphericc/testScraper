# Aider
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/

# Local chat artifacts
chat-history.json
chat.js

# Local Node tooling (Claude Code + Qwen routing — not part of the app)
node_modules/
package.json
package-lock.json
# Live queue capture JSONL files (regenerated per run, large)
# may contain auth tokens / ticket data from a real drop. Never commit.
logs/queue_events_*.jsonl
logs/queue_capture_*.jsonl
# Nightly-restart wrapper + capture-dryrun run logs
# Per-run debugging artifacts (screenshots + activity log dumps)
state/tcin_visibility*

# Stray browser profile dirs (never commit a Chrome profile)
*-test-profile/
