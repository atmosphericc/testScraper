# Walmart bot credentials — COPY THIS FILE TO .env AND FILL IN REAL VALUES.
#   cp .env.example .env    (then edit .env)
# .env is gitignored and never committed — your real creds stay local.
# The app reads these at startup (walmart/config.py). Without them the bot
# cannot log in or pay. Run `python walmart_preflight.py` to check.

# The Walmart account the bot logs in as. Ideally SMS-verified + Walmart+.
WALMART_EMAIL=
WALMART_PASSWORD=

# Card security code (CVV), entered per-order. The card itself lives in the
# Walmart account's saved payment methods; only the CVV is supplied here.
WALMART_CVV=

# --- Target creds are also read by the Target side of this repo (optional) ---
TARGET_EMAIL=
TARGET_PASSWORD=
TARGET_CVV=
